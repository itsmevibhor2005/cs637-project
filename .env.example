# Backend
TRAFFIC_MODE=mock
VIDEO_SOURCE=0
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.35
SERIAL_MODE=mock
SERIAL_PORT=COM5
SERIAL_BAUD=115200
MIN_GREEN=10
MAX_GREEN=40
YELLOW_SECONDS=3
ALL_RED_SECONDS=1
MAX_WAIT_SECONDS=60
FRONTEND_ORIGINS=http://localhost:5173

# SUMO / TraCI integration (opt-in)
# Set SUMO_ENABLED=true to drive the SUMO simulation alongside ESP32.
# SUMO_HOME must be set to your SUMO 1.27.1 installation directory.
SUMO_ENABLED=false
# Default resolves to <project_root>/sumo/cross.sumocfg automatically.
# Override if you move the config file:
# SUMO_CFG=C:/path/to/sumo/cross.sumocfg
SUMO_GUI=true
SUMO_STEP_LENGTH=1.0

# Frontend (put these in frontend/.env if needed)
VITE_API_URL=http://localhost:8000

